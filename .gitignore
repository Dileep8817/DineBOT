# Secrets — never commit
.env
.env.*
!.env.example

# Frontend: only example files are safe to commit (no real keys)
react-frontend/.env
react-frontend/.env.*
!react-frontend/.env.development.example

# Python
venv/
.venv/
__pycache__/
*.py[cod]
.Python
*.egg-info/
.eggs/

# Restaurant JSON (your real menu, hours, etc.) — copy from sample_data/ locally
data/

# Chroma vector DB (can contain embedded content from your data)
chroma_data/

# Frontend build / deps
react-frontend/build/
react-frontend/node_modules/

# Logs & debug
*.log
npm-debug.log*
.cursor/debug*.log

# OS / editor
.DS_Store
.idea/
.vscode/
