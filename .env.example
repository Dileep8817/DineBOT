# Copy to .env (never commit .env)

# PostgreSQL — required (use a real username, not the literal word USER)
# Examples:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/restaurant_ai
# DATABASE_URL=postgresql://your_mac_username@localhost:5432/restaurant_ai
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/restaurant_ai

# App API key (must match react-frontend DINEBOT_PROXY_API_KEY in dev if you use the proxy).
# If omitted, server uses dev default dinebot-local-dev.
# API_KEY=your-secret

# LLM — required for /chat
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=500

# RAG (optional)
# CHROMA_PERSIST_DIR=chroma_data
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=8

# Stripe (optional — Payment Element + webhooks)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` locally or Dashboard in prod
