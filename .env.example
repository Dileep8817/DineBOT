# Copy to .env (never commit .env). The backend loads this file once, in config.py.
# The React app reads the same file via env-cmd (see react-frontend/package.json).

# --- Required -----------------------------------------------------------------

# PostgreSQL. Tables are created on startup.
#   createdb restaurant_ai
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/restaurant_ai

# Local development switch. With DINEBOT_DEV=1 the server accepts the public keys
# below when no key of your own is set. Without it, the server refuses to start
# unless API_KEY is set, so a deployment can never end up unauthenticated.
DINEBOT_DEV=1

# --- Authentication -----------------------------------------------------------
# Two separate secrets: the customer key reaches every browser that loads the
# widget, the staff key must not. Setting one to the other stops startup.
#
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Customer key for the menu, cart, order and chat routes (header: X-API-Key).
# Dev default when DINEBOT_DEV=1: dinebot-local-dev
# API_KEY=
# API_KEYS=key-one,key-two           # csv alternative, for rotation

# Staff key for /staff/* (header: X-Staff-Key). Absent means /staff answers 503.
# Dev default when DINEBOT_DEV=1: dinebot-local-staff
# STAFF_API_KEY=

# --- Browser access -----------------------------------------------------------

# Origins allowed to call the API directly. Required if the SPA is on another
# origin; "*" is refused unless DINEBOT_DEV=1.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dev proxy (react-frontend): the browser calls /api/* and the proxy attaches the
# key server-side, so it never reaches the client bundle. Must match API_KEY.
DINEBOT_PROXY_API_KEY=dinebot-local-dev
# DINEBOT_PROXY_TARGET=http://127.0.0.1:8000

# --- Restaurant data ----------------------------------------------------------

# Where menus are read from. Seed it with:
#   python3 -m scripts.seed_data
# DATA_DIR=data
# SEED_SAMPLE_DATA=0                 # 1 = copy sample_data into DATA_DIR on startup

# --- LLM (required for /chat) -------------------------------------------------

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=500

# --- RAG (optional) -----------------------------------------------------------

# CHROMA_PERSIST_DIR=chroma_data
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=8
# RAG_INDEX_ON_STARTUP=1             # 0 = never index at boot
# RAG_REINDEX=0                      # 1 = re-embed restaurants already indexed

# --- Stripe (optional) --------------------------------------------------------

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...    # from `stripe listen` locally, Dashboard in prod
# REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Frontend (optional) ------------------------------------------------------

# REACT_APP_DEFAULT_RESTAURANT_ID=restaurant_1
# REACT_APP_API_BASE=                # set only if the API is on another origin

# --- Misc ---------------------------------------------------------------------

# LOG_LEVEL=INFO
# RATE_LIMIT_DEFAULT=100/minute
# STAFF_STREAM_POLL_SECONDS=2
# CHAT_HISTORY_MAX_MESSAGES=20
# CHAT_HISTORY_TTL_MINUTES=120
