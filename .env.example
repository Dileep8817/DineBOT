# Copy to .env in the project root (never commit .env).

# PostgreSQL — required
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/restaurant_ai

# API authentication — required (same value as react-frontend DINEBOT_PROXY_API_KEY in dev)
API_KEY=change-me-in-production

# LLM — required for /chat
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=500

# RAG (optional)
# CHROMA_PERSIST_DIR=chroma_data
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=8

# Production: point the built React app at your API (no /api prefix)
# REACT_APP_API_BASE=https://api.yourdomain.com
