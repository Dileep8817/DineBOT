# Copy to .env and set your values

# Database: leave empty or use sqlite:///./dinebot.db for local dev (no Postgres).
# If DATABASE_URL is PostgreSQL but the server is unreachable, the app falls back to SQLite (see DATABASE_FORCE_POSTGRES).
# DATABASE_URL=
# DATABASE_URL=sqlite:///./dinebot.db
# DATABASE_URL=postgresql://YOUR_USER@localhost:5432/restaurant_ai

# Optional: API key for protected/admin routes (comma-separated for multiple)
# API_KEY=your-secret-key
# API_KEYS=key1,key2

# CORS: comma-separated origins (default: http://localhost:3000,http://127.0.0.1:3000)
# CORS_ORIGINS=https://your-frontend.com,https://app.example.com

# Frontend: set REACT_APP_API_BASE in react-frontend/.env for production
# REACT_APP_API_BASE=https://your-api.com

# LLM (OpenAI) – required for /chat
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=500

# RAG (optional): vector store and retrieval
# CHROMA_PERSIST_DIR=chroma_data
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=8
